# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# CAS field-run attachments are generated on the Windows workstation.
/artifacts/covert-alert-system/android-test-package/preflight-results/

# receipt-durability harness toolchain cache
scripts/.cache/

# Local SMS-flow verification scratch (emulator/gradle/postgres state)
.cas-flow/

# Android test-package build outputs
/artifacts/covert-alert-system/android-test-package/.gradle/
/artifacts/covert-alert-system/android-test-package/app/build/

# Local Android toolchain + emulator state (task verification rigs)
/android/
/.android-sdk/
/.android-avd/
/.gradle-dist/
/.gradle-home/

# Field-build-only Firebase config for the capture-request push wake
# (deployment-specific; see app/build.gradle.kts) — never committed.
/artifacts/covert-alert-system/android-test-package/app/google-services.json

# Playwright output from the console browser-proof harness (local runs)
/artifacts/covert-alert-system/test-results/
/artifacts/covert-alert-system/playwright-report/

# Field release signing key — key material lives only in the workspace secrets
# CAS_RELEASE_KEYSTORE_B64 / CAS_RELEASE_KEYSTORE_PASSWORD (see
# HANDOFF-TEST-KIT.md T1). Never commit a keystore or a staging copy of one.
*.keystore
*.jks
/artifacts/covert-alert-system/android-test-package/signing/staging/
