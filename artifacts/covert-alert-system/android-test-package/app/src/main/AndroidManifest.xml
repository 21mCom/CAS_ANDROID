<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- MVP alert mode only: POSTs one incident trigger to the configured CAS server,
         then texts responders directly from this SIM (device-direct SMS; no gateway).
         Gate 0A harness runs still perform no network access and no messaging. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- MVP alert mode only: one position fix per alert, captured under a
         bounded wait and sent to responders with its accuracy radius and fix
         age. Gate 0A harness runs never capture location, and the alert still
         leaves immediately when the permission was never granted. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Evidence-capture playground only: bounded microphone clips, with the
         owner-accepted Android recording indicator visible throughout. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Evidence-capture playground only: bounded still/video capture, with
         the owner-accepted Android camera indicator visible throughout. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Evidence-capture playground only: show the bounded capture service
         notification; no attempt is made to hide the OS indicator. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Evidence-capture playground only: bounded work in a visible service
         instead of attempting background capture without an OS indicator. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Evidence-capture playground only: bounded mic recordings in the
         owner-accepted, microphone-typed foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Evidence-capture playground only: bounded camera recordings in the
         owner-accepted, camera-typed foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Evidence-capture playground only: keep the CPU awake through a bounded
         screen-off capture without turning the display back on. Without this
         the partial wake lock throws SecurityException at capture time. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- One-tap self-update only: lets the operator's Download & install tap
         hand a SHA-256-verified APK to PackageInstaller, which shows Android's
         own install confirmation (the one tap). Android still requires the
         per-app "install unknown apps" grant and rejects cross-key updates.
         Never used by any alert path. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- One-tap self-update only: reading whether the current connection is
         metered, so an update download over mobile data always asks first.
         Without this declaration ConnectivityManager throws SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Package visibility: the cover-app picker lists launchable apps,
         which needs this declaration on Android 11+. No third-party package
         queries: no alert path may surface another app's UI, so the app
         never needs to see specific packages. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:theme="@style/Theme.CasPixelTest"
        android:label="CAS Pixel Gate 0A"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:directBootAware="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Evidence-capture playground only: non-exported bounded capture;
             the OS microphone/camera indicator is owner-accepted. -->
        <service android:name=".EvidenceCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
        <!-- Responder-requested capture wake: high-priority data-only FCM
             messages wake the phone and start the bounded capture service
             under the documented push exemption instead of waiting for the
             next check-in. Non-exported, no UI, no alert surface. Builds
             without google-services.json simply never receive a message and
             keep the polling path. -->
        <service android:name=".CapturePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name=".TriggerActivity"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true"
            android:theme="@style/Theme.CasPixelTest.Proxy">
            <intent-filter>
                <action android:name="com.covertalert.pixeltest.action.PROXY_TRIGGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".SmsResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.covertalert.pixeltest.action.SMS_SENT" />
            </intent-filter>
        </receiver>
        <!-- One-tap self-update only: receives the PackageInstaller commit
             result for an update the operator explicitly downloaded and
             verified; the only UI it can surface is the system's own install
             confirmation. Non-exported, explicit in-app broadcasts only. -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>